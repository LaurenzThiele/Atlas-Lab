{
  "name": "roman-roads-atlas",
  "version": "1.0.0",
  "description": "Every Roman road, as an old atlas plate: an interactive map of the Itiner-e network",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "snapshot": "node maps/snapshot.mjs",
    "deploy": "npm run build && gh-pages -d maps/dist -e roman-roads-atlas --add --nojekyll"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "gsap": "^3.15.1",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gh-pages": "^6.3.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "vite": "^8.3.5"
  },
  "private": true
}
