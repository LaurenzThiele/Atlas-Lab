{
  "name": "florence-rain-1966",
  "version": "1.0.0",
  "description": "All the rain that drowned Florence: a 3D map of the Arno basin upstream of Ponte Vecchio",
  "scripts": {
    "dev": "vite --config maps/vite.config.js",
    "build": "vite build maps",
    "snapshot": "node maps/snapshot.mjs",
    "deploy": "npm run build && gh-pages -d maps/dist -e florence-rain-1966 --add --nojekyll"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "maplibre-gl": "^6.16.0"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gh-pages": "^6.3.0",
    "gsap": "^3.15.1",
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  },
  "private": true
}
