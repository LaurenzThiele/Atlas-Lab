{
  "name": "egypt-nile-dots",
  "version": "1.0.0",
  "description": "Where Egypt's people live: an interactive dot map of the Nile valley",
  "scripts": {
    "dev": "vite --config maps/vite.config.js",
    "build": "vite build --config maps/vite.config.js",
    "deploy": "npm run build && gh-pages -d maps/dist -e egypt-nile-dots --add --nojekyll",
    "fonts": "node maps/fonts.mjs",
    "predev": "node maps/fonts.mjs",
    "prebuild": "node maps/fonts.mjs",
    "prepare-layers": "uv run maps/prepare.py",
    "snapshot": "node maps/snapshot.mjs"
  },
  "author": "Laurenz Thiele",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.4.1",
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/extensions": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "gsap": "^3.15.1",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gh-pages": "^6.3.0",
    "playwright": "^1.65.0",
    "subset-font": "^2.9.0",
    "vite": "^8.3.8"
  },
  "private": "true"
}
